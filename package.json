{
  "name": "enigmeta-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "npm run wasm:pdf && npm run wasm:resize",
    "wasm:pdf": "wasm-pack build crates/pdf-extract --target web --out-dir ../../src/wasm/pdf-extract --out-name pdf_extract --release --no-pack",
    "wasm:resize": "wasm-pack build crates/image-resize --target web --out-dir ../../src/wasm/image-resize --out-name image_resize --release --no-pack",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.19.20",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "earcut": "^3.0.1",
    "fflate": "^0.8.2"
  }
}
